# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=fptc
POSTGRES_PASSWORD=change_me_strong_password

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=fptc
RABBITMQ_DEFAULT_PASS=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_64_char_random_hex_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Dev:  http://localhost,http://localhost:3000
# Prod: https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com
