# Leave unset for the web SPA (relative paths, same-origin through Nginx).
#
# Set this only when building for a packaged Capacitor app, which has no
# origin of its own and needs the full Nginx gateway address, e.g. the
# LAN IP of the machine running `docker compose up` for local device/
# emulator testing, or the deployed gateway URL for a production build.
# VITE_API_BASE_URL=http://192.168.1.20:80
